<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lexica.Core\Lexica.Core.csproj" />
    <ProjectReference Include="..\Lexica.Infrastructure\Lexica.Infrastructure.csproj" />
    <ProjectReference Include="..\Lexica.Shared\Lexica.Shared.csproj" />
  </ItemGroup>

  <!--
    Bij F5/Build vanuit Visual Studio: zorg dat Postgres en de frontend draaien.
    Wordt overgeslagen voor CLI-builds (dotnet build/test), CI, en niet-Debug.
    Uitschakelen: set env var LEXICA_SKIP_DEV_DEPS=true
  -->
  <Target Name="LexicaEnsureDevDependencies"
          BeforeTargets="Build"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' AND '$(Configuration)' == 'Debug' AND '$(OS)' == 'Windows_NT' AND '$(LEXICA_SKIP_DEV_DEPS)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\ensure-dev-deps.ps1&quot;"
          IgnoreExitCode="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
