# Kopieer dit bestand naar .env en pas waarden aan.
# .env zit in .gitignore en wordt niet gecommit.

# Postgres wachtwoord voor de applicatie-gebruiker
DB_PASSWORD=ChangeThis_Strong_P@ss_2026

# JWT signing key — min 32 tekens
JWT_KEY=this-is-a-development-jwt-signing-key-min-32-chars

# Docker image tag (overschreven door GitHub Actions deploy)
LEXICA_IMAGE=ghcr.io/tjanssens/lexica:latest

# Web Push (VAPID) — private sleutel voor notificaties.
# Genereer een paar met: npx web-push generate-vapid-keys --json
# De PUBLIEKE sleutel staat in docker-compose.yml (Push__PublicKey) en
# environment.production.ts; alleen de private sleutel hoort hier.
# Leeg laten = notificaties uitgeschakeld (app blijft werken).
PUSH_PRIVATE_KEY=
